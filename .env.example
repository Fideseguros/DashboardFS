# App
APP_SECRET_KEY=change-me-to-a-random-string
DATABASE_PATH=data/fide.db

# PII encryption (MUST be set in production, ~64 random chars)
FIELD_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Session: máximo absoluto y expiración por inactividad
SESSION_EXPIRY_HOURS=10
SESSION_IDLE_MINUTES=60

# Contraseñas y verificación en dos pasos (TOTP)
PASSWORD_MIN_LENGTH=12
TOTP_ISSUER=FIDES Seguro

# Login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Cookie security (set to 0 only for local dev over HTTP)
COOKIE_SECURE=1

# Solo desarrollo local: permite arrancar sin FIELD_ENCRYPTION_KEY (PII en texto plano)
# ALLOW_PLAINTEXT_PII=1
# Solo desarrollo local: habilita /docs y /openapi.json (en producción van apagados)
# FIDE_ENABLE_DOCS=1
